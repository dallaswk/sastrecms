TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

RESEND_API_KEY=re_your_key

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4321

# El plano de control. Opcional: sin esto la aplicación sirve un solo sitio, que es
# el modo mono-inquilino de siempre. Con esto, el dominio de cada petición decide a
# qué inquilino pertenece — y un dominio que no esté dado de alta sigue sirviendo el
# sitio por defecto, para que añadirlo no apague una instalación que ya funciona.
#   npm run db:control:migrate
#   npm run control -- add-tenant <slug> <nombre>
CONTROL_DATABASE_URL=libsql://your-control-plane.turso.io
CONTROL_AUTH_TOKEN=your-auth-token
