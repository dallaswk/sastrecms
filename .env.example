TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

RESEND_API_KEY=re_your_key

# Medios. En producción van a R2: el binding R2_BUCKET se declara en wrangler.toml y la URL
# pública es la del dominio del bucket. En `astro dev` no hay bindings, así que sin esto los
# archivos se guardan en public/uploads/ y se sirven desde el propio origen — suficiente para
# montar un sitio en local, y nunca en Workers.
R2_PUBLIC_URL=https://media.tu-dominio.com

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4321

# El plano de control. Opcional: sin esto la aplicación sirve un solo sitio, que es
# el modo mono-inquilino de siempre. Con esto, el dominio de cada petición decide a
# qué inquilino pertenece — y un dominio que no esté dado de alta sigue sirviendo el
# sitio por defecto, para que añadirlo no apague una instalación que ya funciona.
#   npm run db:control:migrate
#   npm run control -- add-tenant <slug> <nombre>
CONTROL_DATABASE_URL=libsql://your-control-plane.turso.io
CONTROL_AUTH_TOKEN=your-auth-token

# Stripe. Sólo hace falta el secreto de firma del webhook: el endpoint no llama a la API
# de Stripe, porque el evento ya trae lo que necesita. Apunta el webhook a
# /api/stripe/webhook con estos eventos:
#   customer.subscription.created / .updated / .deleted
#   invoice.paid, invoice.payment_succeeded, invoice.payment_failed
# Y guarda el id de cliente de Stripe en el inquilino:
#   npm run control -- billing <slug> paid --ref=cus_XXXX
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret
