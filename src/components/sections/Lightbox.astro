---
/**
 * One lightbox for the whole page, shared by every gallery on it.
 *
 * Uses a native <dialog>, which brings the focus trap, the Esc key and the inert
 * background for free — a hand-rolled overlay gets all three wrong. Astro dedupes this
 * component's script, so two galleries do not ship it twice, and a page without a gallery
 * ships none of it.
 *
 * Without JavaScript the galleries stay a plain grid of images: the lightbox is an
 * enhancement, never the only way to see them.
 */
---

<dialog id="sastre-lightbox" class="backdrop:bg-black/80 bg-transparent p-0 max-w-none w-full h-full m-0">
  <div class="w-full h-full flex flex-col items-center justify-center gap-3 p-4">
    <img id="sastre-lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded" />

    <div class="flex items-center gap-4 text-white/80 text-sm">
      <button type="button" data-lb="prev" class="btn btn-sm btn-circle btn-ghost text-white" aria-label="Anterior">‹</button>
      <span id="sastre-lightbox-count" class="tabular-nums"></span>
      <button type="button" data-lb="next" class="btn btn-sm btn-circle btn-ghost text-white" aria-label="Siguiente">›</button>
    </div>

    <button type="button" data-lb="close" class="absolute top-4 right-4 btn btn-sm btn-circle btn-ghost text-white" aria-label="Cerrar">✕</button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("sastre-lightbox") as HTMLDialogElement | null;
  const image = document.getElementById("sastre-lightbox-img") as HTMLImageElement | null;
  const counter = document.getElementById("sastre-lightbox-count");
  if (dialog && image) {
    let sources: string[] = [];
    let index = 0;

    function show(i: number) {
      if (!sources.length) return;
      index = (i + sources.length) % sources.length;
      image!.src = sources[index];
      if (counter) counter.textContent = `${index + 1} / ${sources.length}`;
    }

    // Delegated, so galleries rendered later still work and no listener is added per image.
    document.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement)?.closest<HTMLElement>("[data-lightbox] img");
      if (!target) return;
      const group = target.closest("[data-lightbox]");
      if (!group) return;

      sources = [...group.querySelectorAll("img")].map((el) => (el as HTMLImageElement).src);
      show(sources.indexOf((target as HTMLImageElement).src));
      dialog!.showModal();
    });

    dialog.addEventListener("click", (event) => {
      const action = (event.target as HTMLElement)?.closest<HTMLElement>("[data-lb]")?.dataset.lb;
      if (action === "next") show(index + 1);
      else if (action === "prev") show(index - 1);
      else if (action === "close") dialog!.close();
      // The dialog fills the viewport, so a click that hit neither the image nor a control
      // is a click on the backdrop.
      else if (event.target === dialog) dialog!.close();
    });

    document.addEventListener("keydown", (event) => {
      if (!dialog!.open) return;
      if (event.key === "ArrowRight") show(index + 1);
      if (event.key === "ArrowLeft") show(index - 1);
    });

    // Free the image when closing so a large one is not held in memory.
    dialog.addEventListener("close", () => {
      image!.src = "";
    });
  }
</script>
