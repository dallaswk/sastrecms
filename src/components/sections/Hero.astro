---
import SmartImage from "@components/SmartImage.astro";
import { imgProps } from "@lib/media-lookup";
/**
 * Semantic daisyUI classes only (bg-base-100, text-primary…), so the CSS variables
 * BaseLayout injects from settings.theme keep control of the palette. And never build a
 * class name by interpolation: Tailwind scans these files as text, so `bg-${x}` emits
 * nothing. Variants map through a literal lookup.
 */
interface Props {
  media?: Map<string, import("@lib/media-lookup").MediaInfo>;
  id: string;
  anchor?: string;
  data: Record<string, unknown>;
  index: number;
  /** Si es la primera portada de la página. No es lo mismo que ser el primer bloque. */
  firstOfType?: boolean;
}
const { id, anchor, data, index, firstOfType, media } = Astro.props;

const title = (data.title as string) ?? "";
const subtitle = (data.subtitle as string) ?? "";
const image = (data.image as string) ?? "";
const ctaLabel = (data.cta_label as string) ?? "";
const ctaUrl = (data.cta_url as string) ?? "";

const ALIGN = {
  izquierda: "text-left items-start",
  centro: "text-center items-center",
} as const;
const align = ALIGN[(data.align as keyof typeof ALIGN) ?? "centro"] ?? ALIGN.centro;

/*
 * Sin imagen, un degradado en lugar de un plano gris.
 *
 * La mayoría de las portadas nacen sin foto —el cliente aún no la ha mandado, o la página
 * no la necesita— y `bg-base-200` a secas dejaba una banda plana que se lee como un hueco
 * por rellenar. El degradado sale de la propia paleta del sitio, así que no impone color:
 * arranca en el tono de superficie y se funde con el fondo del bloque siguiente.
 */
const surface = image
  ? "bg-base-200"
  : "bg-gradient-to-b from-base-200 via-base-100 to-base-100";

/*
 * La primera portada de la página es el primer botón que se ve; el resto no compite.
 *
 * Lo decide `SectionList`, no el índice: con un aviso o una franja encima, la portada no está
 * en la posición 0 y `index === 0` no se cumplía nunca — que es como estaba escrito y por qué
 * el botón grande no salía en la home.
 */
const ctaSize = firstOfType ? "btn-primary btn-lg" : "btn-primary";
---

<section id={anchor ?? id} class:list={["relative overflow-hidden", surface]}>
  {image && (
    <SmartImage
      {...imgProps(media, image, { decorative: true })}
      class="absolute inset-0 w-full h-full object-cover opacity-30"
      sizes="100vw"
      renderWidth={1600}
      priority={index === 0}
    />
  )}
  <div class={`relative site-wide px-4 py-24 flex flex-col gap-5 ${align}`}>
    <h1 class="text-4xl md:text-5xl font-bold text-base-content text-balance max-w-4xl">{title}</h1>
    {subtitle && <p class="text-lg text-base-content/70 max-w-2xl leading-relaxed">{subtitle}</p>}
    {ctaLabel && ctaUrl && (
      <a href={ctaUrl} class:list={["btn mt-2", ctaSize]}>{ctaLabel}</a>
    )}
  </div>
</section>
