---
interface Props {
  id: string;
  anchor?: string;
  data: Record<string, unknown>;
  index: number;
}
const { id, anchor, data } = Astro.props;

const title = (data.title as string) ?? "";
const text = (data.text as string) ?? "";
const label = (data.button_label as string) ?? "";
const url = (data.button_url as string) ?? "";

// Literal lookup, not interpolation: Tailwind cannot see a class it never reads as text.
const TONE = {
  claro: "bg-base-100 text-base-content",
  oscuro: "bg-neutral text-neutral-content",
  color: "bg-primary text-primary-content",
} as const;
const tone = TONE[(data.tone as keyof typeof TONE) ?? "color"] ?? TONE.color;
---

<section id={anchor ?? id} class={tone}>
  <div class="site-narrow px-4 py-16 flex flex-col items-center text-center gap-4">
    <h2 class="text-3xl font-bold">{title}</h2>
    {text && <p class="opacity-80">{text}</p>}
    {label && url && <a href={url} class="btn btn-secondary">{label}</a>}
  </div>
</section>
