---
import { SECTION_COMPONENTS } from "./index";
import type { SectionInstance, SectionError } from "@lib/sections/types";
import { formatSectionErrors } from "@lib/sections/validate";

interface Props {
  sections: SectionInstance[];
  /** Blocks parseSections refused. Shown in dev only. */
  errors?: SectionError[];
  /** The node being rendered. Only the contact form needs it — a form has to tell the
   *  endpoint which page it is on so the server can read its real field list. */
  nodeId?: string;
  /** Every image on the page, looked up once. Keyed by URL, which is what fields store. */
  media?: Map<string, import("@lib/media-lookup").MediaInfo>;
}
const { sections, errors = [], nodeId, media } = Astro.props;
---

{import.meta.env.DEV && errors.length > 0 && (
  <div class="alert alert-warning m-4 text-sm">
    <span>
      <strong>{errors.length} bloque(s) no se han pintado.</strong> {formatSectionErrors(errors)}
    </span>
  </div>
)}

{sections.filter((s) => !s.hidden).map((section, index) => {
  const Component = SECTION_COMPONENTS[section.type as keyof typeof SECTION_COMPONENTS];

  // An unknown type renders nothing in production rather than taking the page down:
  // an agent inventing a section must not be able to break a client's site. In dev it
  // says so out loud.
  if (!Component) {
    return import.meta.env.DEV
      ? <div class="alert alert-warning m-4">Sección desconocida: {section.type}</div>
      : null;
  }

  return (
    <Component
      id={section.id}
      anchor={section.anchor}
      data={section.data}
      index={index}
      nodeId={nodeId}
      media={media}
    />
  );
})}
