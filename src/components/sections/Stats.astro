---
interface Props { id: string; anchor?: string; data: Record<string, unknown>; index: number }
const { id, anchor, data } = Astro.props;
const items = Array.isArray(data.items) ? (data.items as Record<string, unknown>[]) : [];
---
<section id={anchor ?? id} class="bg-base-200">
  <div class="max-w-5xl mx-auto px-4 py-14 flex flex-col gap-8">
    {data.title && <h2 class="text-3xl font-bold">{data.title}</h2>}
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
      {items.map((item) => (
        <div class="flex flex-col gap-1">
          <span class="text-4xl font-bold text-primary tabular-nums">{item.value}</span>
          <span class="text-sm text-base-content/60">{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
