---
import SmartImage from "@components/SmartImage.astro";
import { imgProps } from "@lib/media-lookup";
interface Props {
  media?: Map<string, import("@lib/media-lookup").MediaInfo>; id: string; anchor?: string; data: Record<string, unknown>; index: number }
const { id, anchor, data, media } = Astro.props;
const right = ((data.side as string) ?? "derecha") === "derecha";
---
<section id={anchor ?? id} class="bg-base-100">
  <div class="site-wide px-4 py-16 grid md:grid-cols-2 gap-10 items-center">
    <div class={`flex flex-col gap-4 ${right ? "" : "md:order-2"}`}>
      <h2 class="text-3xl font-bold">{data.title}</h2>
      {data.body && <div class="prose max-w-none" set:html={data.body as string} />}
      {data.cta_label && data.cta_url && (
        <a href={data.cta_url as string} class="btn btn-primary btn-sm self-start">{data.cta_label}</a>
      )}
    </div>
    {data.image ? (
      <SmartImage
        {...imgProps(media, data.image as string)}
        class="rounded-xl w-full object-cover aspect-[4/3]"
        sizes="(max-width: 768px) 100vw, 50vw"
        renderWidth={800}
      />
    ) : (
      <div class="rounded-xl w-full aspect-[4/3] bg-base-200" aria-hidden="true"></div>
    )}
  </div>
</section>
