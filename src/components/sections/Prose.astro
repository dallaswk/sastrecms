---
import { sanitizeHtml } from "@lib/sanitize";
interface Props {
  media?: Map<string, import("@lib/media-lookup").MediaInfo>; id: string; anchor?: string; data: Record<string, unknown>; index: number }
const { id, anchor, data } = Astro.props;
const title = (data.title as string) ?? "";
// Literal lookup, never interpolation: Tailwind cannot see a class it never reads as text.
// `site-narrow` follows the container width from settings; `max-w-prose` is a fixed measure
// for a block the owner explicitly wants narrow regardless.
const WIDTH = { estrecho: "max-w-prose", normal: "site-narrow" } as const;
const width = WIDTH[(data.width as keyof typeof WIDTH) ?? "normal"] ?? WIDTH.normal;
---
<section id={anchor ?? id} class="bg-base-100">
  <div class={`${width} mx-auto px-4 py-14 flex flex-col gap-4`}>
    {title && <h2 class="text-3xl font-bold">{title}</h2>}
    <div class="prose max-w-none" set:html={sanitizeHtml((data.body as string) ?? "")} />
  </div>
</section>
