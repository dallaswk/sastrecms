---
import SmartImage from "@components/SmartImage.astro";
import { imgProps } from "@lib/media-lookup";
interface Props {
  media?: Map<string, import("@lib/media-lookup").MediaInfo>; id: string; anchor?: string; data: Record<string, unknown>; index: number }
const { id, anchor, data, media } = Astro.props;
const items = Array.isArray(data.items) ? (data.items as Record<string, unknown>[]) : [];
---
<section id={anchor ?? id} class="bg-base-100">
  <div class="site-wide px-4 py-16 flex flex-col gap-8">
    {data.title && <h2 class="text-3xl font-bold">{data.title}</h2>}
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3">
      {items.map((item) => (
        <div class="flex flex-col gap-2">
          {item.photo ? (
            <img
              src={item.photo as string}
              alt={imgProps(media, item.photo as string, { fallbackAlt: item.name as string }).alt}
              width="80" height="80"
              class="w-20 h-20 rounded-full object-cover" loading="lazy" decoding="async"
            />
          ) : (
            <div class="w-20 h-20 rounded-full bg-base-200" aria-hidden="true"></div>
          )}
          <div>
            <p class="font-semibold">{item.name}</p>
            {item.role && <p class="text-sm text-base-content/50">{item.role}</p>}
          </div>
          {item.bio && <p class="text-sm text-base-content/70 leading-relaxed">{item.bio}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
