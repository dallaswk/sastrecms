---
import type { ResolvedItem } from "@lib/menus";

interface Props {
  siteName: string;
  tagline?: string | null;
  items: ResolvedItem[];
  legal: ResolvedItem[];
  social: { label: string; url: string }[];
}
const { siteName, tagline, items, legal, social } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-base-200 border-t border-base-300 mt-auto">
  <div class="site-wide px-4 py-12 flex flex-col gap-8">
    <div class="flex flex-wrap gap-8 justify-between">
      <div class="flex flex-col gap-1 max-w-xs">
        <span class="font-semibold">{siteName}</span>
        {tagline && <span class="text-sm text-base-content/60">{tagline}</span>}
      </div>

      {items.length > 0 && (
        <nav class="flex flex-col gap-2 text-sm" aria-label="Pie">
          {items.map((item) => (
            <a href={item.href} class="text-base-content/70 hover:text-base-content"
               {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >{item.label}</a>
          ))}
        </nav>
      )}

      {social.length > 0 && (
        <div class="flex flex-col gap-2 text-sm">
          <span class="text-xs uppercase tracking-wide text-base-content/40 font-semibold">Síguenos</span>
          <div class="flex gap-3">
            {social.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 class="text-base-content/70 hover:text-base-content">{s.label}</a>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="flex flex-wrap gap-x-4 gap-y-2 items-center justify-between border-t border-base-300 pt-6 text-sm text-base-content/50">
      <span>© {year} {siteName}</span>
      {legal.length > 0 && (
        <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label="Legal">
          {legal.map((item) => (
            <a href={item.href} class="hover:text-base-content">{item.label}</a>
          ))}
        </nav>
      )}
    </div>
  </div>
</footer>
