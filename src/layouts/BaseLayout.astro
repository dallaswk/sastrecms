---
import "@styles/global.css";
import { buildWebSiteSchema } from "@lib/jsonld";
import { sanitizeAnalyticsIds } from "@lib/analytics";
import { buildMeta, buildHreflang } from "@lib/seo";
import ConsentBanner from "@components/site/ConsentBanner.astro";
import {
  DEFAULT_THEME,
  googleFontsHref,
  isSiteTheme,
  themeFingerprint,
  type SiteTheme,
} from "@lib/theme";
import { referencedNodeIds, resolveMenu } from "@lib/menus";
import { and, eq, inArray } from "drizzle-orm";
import { nodes } from "@db/schema";
import SiteHeader from "@components/site/SiteHeader.astro";
import SiteFooter from "@components/site/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Alt text for the share card. Falls back to the title. */
  ogImageAlt?: string;
  /** `article` for a post, so crawlers read the dates. */
  ogType?: "website" | "article";
  /** Overrides the canonical, for a page that duplicates another. */
  canonical?: string;
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  jsonLdList?: Record<string, unknown>[];
  hreflangLinks?: { locale: string; path: string }[];
  /** The node's own locale. Astro.currentLocale is empty without i18n routing. */
  lang?: string;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType,
  canonical,
  publishedAt,
  updatedAt,
  author,
  noindex = false,
  jsonLd,
  jsonLdList,
  hreflangLinks,
  lang,
} = Astro.props;
const schemas = jsonLdList ?? (jsonLd ? [jsonLd] : []);
// `site` is deliberately not set in astro.config.ts: each client deployment has its own
// domain and it isn't known at build time. Fall back to the request origin, same as
// sitemap.xml.ts — without this every public page throws "Invalid URL".
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

// Loaded once per request by the middleware; re-querying here cost a second round
// trip to Turso on every public page.
const siteSettings = Astro.locals.settings;

// settings.update validates these on the way in; this drops anything stored before
// that validation existed, which would otherwise be executable JS in the tags below.
const analytics = sanitizeAnalyticsIds(siteSettings?.analyticsIds);

const theme = (siteSettings?.theme ?? {}) as SiteTheme;

/*
 * The palette is served from /theme.css rather than inlined here.
 *
 * It is what makes a strict CSP possible: Astro hashes inline styles at build time, and a
 * block whose contents come from the database per request can never match a build-time hash.
 * The fingerprint in the URL is what lets it be cached forever and still change the instant
 * the owner saves a colour.
 */
const themeHref = `/theme.css?v=${themeFingerprint(theme)}`;

const fontsHref = googleFontsHref(theme.fontHeading, theme.fontBody);

const daisyuiTheme = isSiteTheme(theme.daisyuiTheme) ? theme.daisyuiTheme : DEFAULT_THEME;
/*
 * Menus store node ids, not paths, so a renamed slug does not silently break every page's
 * navigation. That costs one lookup — but only when a menu actually points at content;
 * a site whose menu is all external links pays nothing.
 */
const menus = siteSettings?.menus ?? {};
const menuNodeIds = referencedNodeIds(menus);
const menuPaths = new Map<string, string>();
if (menuNodeIds.length > 0 && Astro.locals.db) {
  const rows = await Astro.locals.db.query.nodes.findMany({
    // Acotada por sitio además de por id. Los ids salen de los ajustes de este sitio, así que
    // en la práctica no apuntan a otro — pero «en la práctica» es justo lo que no vale en una
    // base compartida: basta con que unos ajustes queden mal copiados para que la cabecera de
    // un cliente enlace a la página de otro.
    where: and(eq(nodes.siteId, Astro.locals.siteId), inArray(nodes.id, menuNodeIds)),
    columns: { id: true, path: true, status: true },
  });
  for (const row of rows) {
    // A draft in the menu would be a link to a 404 on every page of the site.
    if (row.status === "published") menuPaths.set(row.id, row.path);
  }
}

const mainMenu = resolveMenu(menus, "main", menuPaths);
const footerMenu = resolveMenu(menus, "footer", menuPaths);
const legalMenu = resolveMenu(menus, "legal", menuPaths);

const socialLinks = Object.entries(
  (siteSettings?.socialLinks as Record<string, string> | null) ?? {}
)
  .filter(([, url]) => typeof url === "string" && url.trim())
  .map(([key, url]) => ({ label: key.charAt(0).toUpperCase() + key.slice(1), url }));

const defaultLocale = Astro.locals.site?.defaultLocale ?? "es";
const homeHref = (lang ?? defaultLocale) === defaultLocale ? "/" : `/${lang}`;

const faviconUrl = siteSettings?.faviconUrl ?? "/favicon.svg";
const siteTitle = siteSettings?.siteName ?? "sASTRe";
// No suffix when the page is already the site: the home page of sASTRe was titled
// "sASTRe — sASTRe", which is what building the real landing surfaced.
const pageTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;

const rawSocial = (siteSettings?.socialLinks ?? {}) as Record<string, string>;

// Taken from the legal menu rather than from a hardcoded slug: the page can be called
// whatever the client wants, and the menu is where it is already declared.
const cookiesPath = legalMenu.find((item) => /cookie/i.test(item.href) || /cookie/i.test(item.label))?.href;

const metaTags = buildMeta({
  title,
  ...(description ? { description } : {}),
  url: canonicalUrl.toString(),
  ...(canonical ? { canonical } : {}),
  siteName: siteTitle,
  ...(ogImage ? { image: ogImage } : {}),
  ...(ogImageAlt ? { imageAlt: ogImageAlt } : {}),
  locale: lang ?? Astro.currentLocale ?? "es",
  type: ogType ?? "website",
  noindex,
  ...(publishedAt ? { publishedAt } : {}),
  ...(updatedAt ? { updatedAt } : {}),
  ...(author ? { author } : {}),
  ...(rawSocial.twitter ? { twitterSite: rawSocial.twitter } : {}),
});

// x-default and the self-reference included: Google ignores a hreflang set where the page
// does not point at itself, which is the commonest way a correct-looking block does nothing.
const hreflangs = buildHreflang(hreflangLinks ?? [], Astro.url.origin, defaultLocale);

---

<!doctype html>
<html lang={lang ?? Astro.currentLocale ?? "es"} data-theme={daisyuiTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />

    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical?.trim() || canonicalUrl.toString()} />

    {/* Every meta tag comes from @lib/seo so the rules are in one testable place: an
        absolute OG image, a positive robots directive, and a Twitter card that is `large`
        only when there is actually an image to make it large. */}
    {metaTags.map((tag) =>
      tag.property
        ? <meta property={tag.property} content={tag.content} />
        : <meta name={tag.name} content={tag.content} />
    )}

    {hreflangs.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    <link rel="stylesheet" href={themeHref} />

    {fontsHref && (
      <Fragment>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={fontsHref} />
      </Fragment>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(buildWebSiteSchema(siteTitle, Astro.url.origin))} />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {/* Google Search Console verification */}
    {analytics.gscVerification && (
      <meta name="google-site-verification" content={analytics.gscVerification} />
    )}

    {/*
      No tracker is loaded here any more.

      Every one of them used to run on page load, before the visitor was asked anything —
      which is the actual GDPR violation, not a missing banner. They now load from
      ConsentBanner's script, only for a category the visitor has accepted.
    */}
  </head>

  <body class="site-root min-h-screen flex flex-col">
    <SiteHeader
      siteName={siteTitle}
      logoUrl={siteSettings?.logoUrl}
      homeHref={homeHref}
      items={mainMenu}
      languages={hreflangLinks ?? []}
      currentLocale={lang ?? defaultLocale}
      pathname={Astro.url.pathname}
    />
    
    <main class="flex-1">
      <slot />
    </main>
    
    <SiteFooter
      siteName={siteTitle}
      tagline={siteSettings?.tagline}
      items={footerMenu}
      legal={legalMenu}
      social={socialLinks}
    />

    <ConsentBanner analytics={analytics} cookiesPath={cookiesPath} />
  </body>
</html>
