---
import "@styles/global.css";
import { eq } from "drizzle-orm";
import { settings } from "@db/schema";
import { buildWebSiteSchema } from "@lib/jsonld";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  jsonLdList?: Record<string, unknown>[];
  hreflangLinks?: { locale: string; path: string }[];
}

const { title, description, ogImage, noindex = false, jsonLd, jsonLdList, hreflangLinks } = Astro.props;
const schemas = jsonLdList ?? (jsonLd ? [jsonLd] : []);
// `site` is deliberately not set in astro.config.ts: each client deployment has its own
// domain and it isn't known at build time. Fall back to the request origin, same as
// sitemap.xml.ts — without this every public page throws "Invalid URL".
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

const siteSettings = Astro.locals.db
  ? await Astro.locals.db.query.settings.findFirst({
      where: eq(settings.siteId, "site_default"),
    })
  : null;

type AnalyticsIds = {
  ga4?: string; gtm?: string; metaPixel?: string;
  tiktokPixel?: string; hotjar?: string; gscVerification?: string;
};
const analytics = (siteSettings?.analyticsIds as AnalyticsIds | null) ?? {};

const theme = (siteSettings?.theme as Record<string, string> | null) ?? {};

const CSS_VAR_MAP: Record<string, string> = {
  primaryColor: "--p",
  secondaryColor: "--s",
  accentColor: "--a",
  baseColor: "--b1",
  borderRadius: "--rounded-box",
};

const themeVars = Object.entries(theme)
  .filter(([k]) => CSS_VAR_MAP[k])
  .map(([k, v]) => `${CSS_VAR_MAP[k]}: ${v};`)
  .join(" ");

const daisyuiTheme = (theme as Record<string, string>).daisyuiTheme ?? "light";
const faviconUrl = siteSettings?.faviconUrl ?? "/favicon.svg";
const siteTitle = siteSettings?.siteName ?? "sASTRe";
---

<!doctype html>
<html lang={Astro.currentLocale ?? "es"} data-theme={daisyuiTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />

    <title>{title} — {siteTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks && hreflangLinks.length > 1 && hreflangLinks.map(({ locale, path }) => (
      <link rel="alternate" hreflang={locale} href={new URL(path, Astro.url.origin).toString()} />
    ))}

    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}

    {themeVars && (
      <style set:html={`:root { ${themeVars} }`} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(buildWebSiteSchema(siteTitle, Astro.url.origin))} />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {/* Google Search Console verification */}
    {analytics.gscVerification && (
      <meta name="google-site-verification" content={analytics.gscVerification} />
    )}

    {/* Google Tag Manager — <head> snippet */}
    {analytics.gtm && (
      <script set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${analytics.gtm}');`} />
    )}

    {/* Google Analytics 4 (standalone, skip if GTM already handles it) */}
    {analytics.ga4 && !analytics.gtm && (
      <Fragment>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4}`} />
        <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${analytics.ga4}');`} />
      </Fragment>
    )}

    {/* Meta Pixel */}
    {analytics.metaPixel && (
      <script set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${analytics.metaPixel}');fbq('track','PageView');`} />
    )}

    {/* TikTok Pixel */}
    {analytics.tiktokPixel && (
      <script set:html={`!function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=['page','track','identify','instances','debug','on','off','once','ready','alias','group','enableCookie','disableCookie'];ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};ttq.load=function(e,n){var i='https://analytics.tiktok.com/i18n/pixel/events.js';ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=i;ttq._t=ttq._t||{};ttq._t[e]=+new Date;ttq._o=ttq._o||{};ttq._o[e]=n||{};var o=document.createElement('script');o.type='text/javascript';o.async=!0;o.src=i+'?sdkid='+e+'&lib='+t;var a=document.getElementsByTagName('script')[0];a.parentNode.insertBefore(o,a)};ttq.load('${analytics.tiktokPixel}');ttq.page()}(window,document,'ttq');`} />
    )}

    {/* Hotjar */}
    {analytics.hotjar && (
      <script set:html={`(function(h,o,t,j,a,r){h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};h._hjSettings={hjid:${analytics.hotjar},hjsv:6};a=o.getElementsByTagName('head')[0];r=o.createElement('script');r.async=1;r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;a.appendChild(r);})(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');`} />
    )}
  </head>
  <body>
    {/* Google Tag Manager — <body> noscript fallback */}
    {analytics.gtm && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${analytics.gtm}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}
    <slot />
  </body>
</html>
