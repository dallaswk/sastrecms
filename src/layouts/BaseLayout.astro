---
import "@styles/global.css";
import { buildWebSiteSchema } from "@lib/jsonld";
import { sanitizeAnalyticsIds } from "@lib/analytics";
import { themeColorValue } from "@lib/color";
import { referencedNodeIds, resolveMenu } from "@lib/menus";
import { inArray } from "drizzle-orm";
import { nodes } from "@db/schema";
import SiteHeader from "@components/site/SiteHeader.astro";
import SiteFooter from "@components/site/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  jsonLdList?: Record<string, unknown>[];
  hreflangLinks?: { locale: string; path: string }[];
  /** The node's own locale. Astro.currentLocale is empty without i18n routing. */
  lang?: string;
}

const { title, description, ogImage, noindex = false, jsonLd, jsonLdList, hreflangLinks, lang } = Astro.props;
const schemas = jsonLdList ?? (jsonLd ? [jsonLd] : []);
// `site` is deliberately not set in astro.config.ts: each client deployment has its own
// domain and it isn't known at build time. Fall back to the request origin, same as
// sitemap.xml.ts — without this every public page throws "Invalid URL".
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

// Loaded once per request by the middleware; re-querying here cost a second round
// trip to Turso on every public page.
const siteSettings = Astro.locals.settings;

// settings.update validates these on the way in; this drops anything stored before
// that validation existed, which would otherwise be executable JS in the tags below.
const analytics = sanitizeAnalyticsIds(siteSettings?.analyticsIds);

const theme = (siteSettings?.theme as Record<string, string> | null) ?? {};

/** daisyUI's readable-foreground variable for each background it derives. */
const CONTRAST_FOR: Record<string, string> = {
  "--p": "--pc",
  "--s": "--sc",
  "--a": "--ac",
};

const CSS_VAR_MAP: Record<string, string> = {
  primaryColor: "--p",
  secondaryColor: "--s",
  accentColor: "--a",
  baseColor: "--b1",
  borderRadius: "--rounded-box",
};

// daisyUI 4 keeps its palette as bare OKLCH components, but settings offers a colour
// picker, which can only give hex. Writing the hex straight in produced an invalid value
// and the theme pickers did nothing at all.
const COLOR_VARS = new Set(["--p", "--s", "--a", "--b1"]);

const themeVars = Object.entries(theme)
  .filter(([k]) => CSS_VAR_MAP[k])
  .map(([k, v]) => {
    const cssVar = CSS_VAR_MAP[k];
    if (!COLOR_VARS.has(cssVar)) return `${cssVar}: ${v};`;
    const converted = themeColorValue(String(v));
    return converted ? `${cssVar}: ${converted};` : "";
  })
  .filter(Boolean)
  .join(" ");

// daisyUI derives the readable foreground from the background, but only for its own
// themes; an overridden --p leaves --pc pointing at the old one. Pick black or white by
// lightness so a custom primary never renders text on top of itself.
const contrastVars = Object.entries(theme)
  .filter(([k]) => CSS_VAR_MAP[k] && CONTRAST_FOR[CSS_VAR_MAP[k]])
  .map(([k, v]) => {
    const converted = themeColorValue(String(v));
    if (!converted) return "";
    const lightness = parseFloat(converted);
    return `${CONTRAST_FOR[CSS_VAR_MAP[k]]}: ${lightness > 60 ? "0% 0 0" : "100% 0 0"};`;
  })
  .filter(Boolean)
  .join(" ");

const daisyuiTheme = (theme as Record<string, string>).daisyuiTheme ?? "light";
/*
 * Menus store node ids, not paths, so a renamed slug does not silently break every page's
 * navigation. That costs one lookup — but only when a menu actually points at content;
 * a site whose menu is all external links pays nothing.
 */
const menus = siteSettings?.menus ?? {};
const menuNodeIds = referencedNodeIds(menus);
const menuPaths = new Map<string, string>();
if (menuNodeIds.length > 0 && Astro.locals.db) {
  const rows = await Astro.locals.db.query.nodes.findMany({
    where: inArray(nodes.id, menuNodeIds),
    columns: { id: true, path: true, status: true },
  });
  for (const row of rows) {
    // A draft in the menu would be a link to a 404 on every page of the site.
    if (row.status === "published") menuPaths.set(row.id, row.path);
  }
}

const mainMenu = resolveMenu(menus, "main", menuPaths);
const footerMenu = resolveMenu(menus, "footer", menuPaths);
const legalMenu = resolveMenu(menus, "legal", menuPaths);

const socialLinks = Object.entries(
  (siteSettings?.socialLinks as Record<string, string> | null) ?? {}
)
  .filter(([, url]) => typeof url === "string" && url.trim())
  .map(([key, url]) => ({ label: key.charAt(0).toUpperCase() + key.slice(1), url }));

const defaultLocale = Astro.locals.site?.defaultLocale ?? "es";
const homeHref = (lang ?? defaultLocale) === defaultLocale ? "/" : `/${lang}`;

const faviconUrl = siteSettings?.faviconUrl ?? "/favicon.svg";
const siteTitle = siteSettings?.siteName ?? "sASTRe";
// No suffix when the page is already the site: the home page of sASTRe was titled
// "sASTRe — sASTRe", which is what building the real landing surfaced.
const pageTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
---

<!doctype html>
<html lang={lang ?? Astro.currentLocale ?? "es"} data-theme={daisyuiTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks && hreflangLinks.length > 1 && hreflangLinks.map(({ locale, path }) => (
      <link rel="alternate" hreflang={locale} href={new URL(path, Astro.url.origin).toString()} />
    ))}

    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}

    {themeVars && (
      <style set:html={`:root { ${themeVars} ${contrastVars} }`} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(buildWebSiteSchema(siteTitle, Astro.url.origin))} />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {/* Google Search Console verification */}
    {analytics.gscVerification && (
      <meta name="google-site-verification" content={analytics.gscVerification} />
    )}

    {/* Google Tag Manager — <head> snippet */}
    {analytics.gtm && (
      <script set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${analytics.gtm}');`} />
    )}

    {/* Google Analytics 4 (standalone, skip if GTM already handles it) */}
    {analytics.ga4 && !analytics.gtm && (
      <Fragment>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4}`} />
        <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${analytics.ga4}');`} />
      </Fragment>
    )}

    {/* Meta Pixel */}
    {analytics.metaPixel && (
      <script set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${analytics.metaPixel}');fbq('track','PageView');`} />
    )}

    {/* TikTok Pixel */}
    {analytics.tiktokPixel && (
      <script set:html={`!function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=['page','track','identify','instances','debug','on','off','once','ready','alias','group','enableCookie','disableCookie'];ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};ttq.load=function(e,n){var i='https://analytics.tiktok.com/i18n/pixel/events.js';ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=i;ttq._t=ttq._t||{};ttq._t[e]=+new Date;ttq._o=ttq._o||{};ttq._o[e]=n||{};var o=document.createElement('script');o.type='text/javascript';o.async=!0;o.src=i+'?sdkid='+e+'&lib='+t;var a=document.getElementsByTagName('script')[0];a.parentNode.insertBefore(o,a)};ttq.load('${analytics.tiktokPixel}');ttq.page()}(window,document,'ttq');`} />
    )}

    {/* Hotjar */}
    {analytics.hotjar && (
      <script set:html={`(function(h,o,t,j,a,r){h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};h._hjSettings={hjid:${analytics.hotjar},hjsv:6};a=o.getElementsByTagName('head')[0];r=o.createElement('script');r.async=1;r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;a.appendChild(r);})(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');`} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    {/* Google Tag Manager — <body> noscript fallback */}
    {analytics.gtm && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${analytics.gtm}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}
    <SiteHeader
      siteName={siteTitle}
      logoUrl={siteSettings?.logoUrl}
      homeHref={homeHref}
      items={mainMenu}
      languages={hreflangLinks ?? []}
      currentLocale={lang ?? defaultLocale}
      pathname={Astro.url.pathname}
    />
    
    <main class="flex-1">
      <slot />
    </main>
    
    <SiteFooter
      siteName={siteTitle}
      tagline={siteSettings?.tagline}
      items={footerMenu}
      legal={legalMenu}
      social={socialLinks}
    />
  </body>
</html>
