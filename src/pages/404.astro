---
import BaseLayout from "@layouts/BaseLayout.astro";
import { referencedNodeIds, resolveMenu } from "@lib/menus";
import { nodes } from "@db/schema";
import { and, eq, inArray } from "drizzle-orm";
export const prerender = false;

/*
 * A real page, not an empty 404.
 *
 * `[...slug]` used to answer `new Response(null, { status: 404 })`, so a mistyped URL on a
 * client's site showed the browser's own error page: no header, no menu, no way back. On a
 * site being handed to a client that reads as the site being broken.
 *
 * Deliberately noindex and never cached: a 404 that gets cached is a page that stays missing
 * after it has been created, which is exactly what happens when a draft is published and
 * someone had already tried the URL.
 */
Astro.response.headers.set("Cache-Control", "no-store");
// And the CDN header, which the `/[...slug]` route rule would otherwise set to an hour: a
// cached 404 is a page that stays missing after it has been created, which is exactly what
// happens when someone tries a URL just before the draft is published.
// swr: 0 too, or the route rule's 24-hour stale window survives and the edge keeps
// serving the 404 from cache while it revalidates.
Astro.cache.set({ maxAge: 0, swr: 0 });

/*
 * El menú principal, resuelto igual que en BaseLayout: los menús guardan ids de nodo, así
 * que hay que traducirlos a rutas, y sólo las de lo que está publicado.
 */
const menus = Astro.locals.settings?.menus ?? {};
const menuIds = referencedNodeIds(menus);
const paths = new Map<string, string>();
if (menuIds.length > 0 && Astro.locals.db) {
  const rows = await Astro.locals.db.query.nodes.findMany({
    // Filtrado por sitio además de por id: los ids vienen de los ajustes de este sitio, pero
    // una lectura de `nodes` sin `siteId` es exactamente la que no debe existir en una base
    // compartida, y el guardián de `tenant-boundary.test.ts` está para que no se cuele ninguna.
    where: and(eq(nodes.siteId, Astro.locals.siteId), inArray(nodes.id, menuIds)),
    columns: { id: true, path: true, status: true },
  });
  for (const row of rows) if (row.status === "published") paths.set(row.id, row.path);
}
const menu = resolveMenu(menus, "main", paths);
---

<BaseLayout title="Página no encontrada" noindex>
  <div class="site-narrow px-4 py-24 flex flex-col items-center text-center gap-4">
    <p class="text-5xl font-black text-primary">404</p>
    <h1 class="text-2xl font-bold">Esta página no existe</h1>
    <p class="text-base-content/70">
      Puede que el enlace esté mal escrito o que la página se haya movido.
    </p>
    <a href="/" class="btn btn-primary mt-2">Volver al inicio</a>

    {/*
      Las salidas van al menú principal, no a una lista escrita aquí: en un sitio de
      cliente esas rutas no existen —o se llaman de otra forma—, y un 404 lleno de enlaces
      rotos es peor que un 404 sin ellos.
    */}
    {menu.length > 0 && (
      <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2 mt-6 pt-6 border-t border-base-200 w-full text-sm" aria-label="Secciones">
        <span class="text-base-content/50 w-full">O prueba con:</span>
        {menu.map((item) => (
          <a href={item.href} class="link link-hover text-primary">{item.label}</a>
        ))}
      </nav>
    )}
  </div>
</BaseLayout>
