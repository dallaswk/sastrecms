---
import AdminLayout from "@layouts/AdminLayout.astro";
import ContentTypeBuilder from "@components/admin/ContentTypeBuilder.vue";
import { eq, and } from "drizzle-orm";
import { contentTypes } from "@db/schema";
export const prerender = false;

const siteId = Astro.locals.siteId;

const { id } = Astro.params;
const db = Astro.locals.db;
const isNew = id === "new";
let ct = null;

if (!isNew) {
  ct = await db.query.contentTypes.findFirst({
    where: and(eq(contentTypes.id, id!), eq(contentTypes.siteId, siteId)),
  });
  if (!ct) return Astro.redirect("/admin/content-types");
}

// Feeds the relation field's "related content type" select. Excludes the type being
// edited: a relation pointing at its own type is a footgun more often than a feature.
const allTypes = await db.query.contentTypes.findMany({
  where: eq(contentTypes.siteId, siteId),
  columns: { key: true, label: true, id: true },
  orderBy: (t, { asc }) => [asc(t.label)],
});
const relatable = allTypes.filter((t) => t.id !== id).map((t) => ({ key: t.key, label: t.label }));

const title = isNew ? "Nuevo tipo de contenido" : `Editar: ${ct?.label}`;
---

<AdminLayout title={title}>
  <div class="mb-4">
    <a href="/admin/content-types" class="btn btn-ghost btn-sm">← Volver</a>
  </div>

  {!isNew && ct?.isSystem && (
    <div class="alert alert-info mb-6">
      <span>Este es un tipo de sistema. La clave y las opciones base no se pueden modificar, pero puedes añadir o editar campos.</span>
    </div>
  )}

  <ContentTypeBuilder
    client:load
    contentTypeId={isNew ? undefined : id}
    contentTypes={JSON.stringify(relatable)}
    initialData={ct ? {
      key: ct.key,
      label: ct.label,
      hasArchive: ct.hasArchive,
      supportsChildren: ct.supportsChildren,
      translatable: ct.translatable,
      fieldSchema: ct.fieldSchema as never,
    } : undefined}
  />
</AdminLayout>
