---
import "@styles/global.css";
import "@styles/admin.css";
import { ADMIN_THEME_DARK, ADMIN_THEME_LIGHT } from "@lib/theme";
import { eq } from "drizzle-orm";
import { settings } from "@db/schema";
export const prerender = false;

if (Astro.locals.session) {
  return Astro.redirect("/admin");
}

const siteSettings = await Astro.locals.db.query.settings.findFirst({
  where: eq(settings.siteId, Astro.locals.siteId),
});
const integrations = (siteSettings?.integrations as Record<string, string> | null) ?? {};
const hasMagicLink = !!(integrations.resendApiKey && integrations.resendFrom);
---

<!doctype html>
<html lang="es" data-theme={ADMIN_THEME_DARK} data-mode="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceder — sASTRe</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />

    {/* Same pre-paint theme decision as the rest of the backoffice, or signing in flashes. */}
    <script is:inline define:vars={{ dark: ADMIN_THEME_DARK, light: ADMIN_THEME_LIGHT }}>
      (function () {
        try {
          var stored = localStorage.getItem("sastre-admin-mode");
          var prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
          var mode = stored === "light" || (!stored && prefersLight) ? "light" : "dark";
          document.documentElement.dataset.mode = mode;
          document.documentElement.dataset.theme = mode === "light" ? light : dark;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="admin-root bg-base-200 min-h-screen flex items-center justify-center p-4">
    <div class="panel w-full max-w-sm">
      <div class="panel-body">
        <div class="mb-2 flex flex-col gap-1">
          <span class="text-2xl font-black tracking-tight text-primary">sASTRe</span>
          <p class="admin-hint">Accede al panel de administración.</p>
        </div>

        <!-- Tabs -->
        <div role="tablist" class="tabs tabs-bordered mb-4">
          <button role="tab" id="tab-password" class="tab tab-active" onclick="switchTab('password')">Contraseña</button>
          {hasMagicLink && (
            <button role="tab" id="tab-magic" class="tab" onclick="switchTab('magic')">Magic link</button>
          )}
        </div>

        <!-- Password form -->
        <form id="login-form" class="flex flex-col gap-4">
          <div class="field">
            <label for="email">Correo electrónico</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="admin@ejemplo.com"
              class="input input-bordered"
              autocomplete="username"
              required
            />
          </div>
          <div class="field">
            <label for="password">Contraseña</label>
            <input
              id="password"
              name="password"
              type="password"
              class="input input-bordered"
              autocomplete="current-password"
              required
            />
          </div>
          <div id="error-msg" class="field-error hidden" role="alert"></div>
          <button type="submit" class="btn btn-primary w-full">Acceder</button>
        </form>

        <!-- Magic link form -->
        <form id="magic-form" class="flex flex-col gap-4" class:list={[!hasMagicLink && 'hidden']}>
          <p class="text-sm text-base-content/60">Introduce tu email y recibirás un enlace de acceso directo.</p>
          <div class="form-control">
            <label class="label" for="magic-email">
              <span class="label-text">Email</span>
            </label>
            <input id="magic-email" name="email" type="email" placeholder="admin@ejemplo.com" class="input input-bordered" required />
          </div>
          <div id="magic-msg" class="text-sm hidden"></div>
          <button type="submit" class="btn btn-primary w-full">Enviar enlace</button>
        </form>
      </div>
    </div>

    <script>
      function switchTab(tab: "password" | "magic") {
        const tabPassword = document.getElementById("tab-password")!;
        const tabMagic = document.getElementById("tab-magic")!;
        const formPassword = document.getElementById("login-form")!;
        const formMagic = document.getElementById("magic-form")!;
        if (tab === "password") {
          tabPassword.classList.add("tab-active");
          tabMagic.classList.remove("tab-active");
          formPassword.classList.remove("hidden");
          formMagic.classList.add("hidden");
        } else {
          tabMagic.classList.add("tab-active");
          tabPassword.classList.remove("tab-active");
          formMagic.classList.remove("hidden");
          formPassword.classList.add("hidden");
        }
      }
      (window as any).switchTab = switchTab;

      const form = document.getElementById("login-form") as HTMLFormElement;
      const errorMsg = document.getElementById("error-msg") as HTMLDivElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorMsg.classList.add("hidden");

        const data = new FormData(form);
        const res = await fetch("/api/auth/sign-in/email", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: data.get("email"),
            password: data.get("password"),
          }),
        });

        if (res.ok) {
          window.location.href = "/admin";
        } else {
          const body = await res.json().catch(() => ({}));
          errorMsg.textContent = body.message ?? "Credenciales incorrectas";
          errorMsg.classList.remove("hidden");
        }
      });

      const magicForm = document.getElementById("magic-form") as HTMLFormElement;
      const magicMsg = document.getElementById("magic-msg") as HTMLDivElement;

      magicForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        magicMsg.classList.add("hidden");
        const data = new FormData(magicForm);
        const btn = magicForm.querySelector("button[type=submit]") as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = "Enviando...";

        const res = await fetch("/api/auth/sign-in/magic-link", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: data.get("email") }),
        });

        btn.disabled = false;
        btn.textContent = "Enviar enlace";

        if (res.ok) {
          magicMsg.className = "text-sm text-success";
          magicMsg.textContent = "Revisa tu email — enlace enviado.";
          magicMsg.classList.remove("hidden");
        } else {
          const body = await res.json().catch(() => ({}));
          magicMsg.className = "text-sm text-error";
          magicMsg.textContent = body.message ?? "Error al enviar el enlace";
          magicMsg.classList.remove("hidden");
        }
      });
    </script>
  </body>
</html>
