---
import AdminLayout from "@layouts/AdminLayout.astro";
import NodeForm from "@components/admin/NodeForm.vue";
import { eq, and, isNotNull } from "drizzle-orm";
import { nodes, contentTypes } from "@db/schema";
import { checkPermission } from "@lib/permissions";
export const prerender = false;

const { id } = Astro.params;
const db = Astro.locals.db;
const siteId = Astro.locals.siteId;
const userId = Astro.locals.user!.id;

const isNew = id === "new";
const typeId = Astro.url.searchParams.get("type") ?? "";

let node: Awaited<ReturnType<typeof db.query.nodes.findFirst>> | null = null;
let contentType: Awaited<ReturnType<typeof db.query.contentTypes.findFirst>> | null = null;

if (isNew) {
  contentType = await db.query.contentTypes.findFirst({
    where: eq(contentTypes.id, typeId),
  });
  if (!contentType) return Astro.redirect("/admin/content");
} else {
  node = await db.query.nodes.findFirst({
    where: and(eq(nodes.id, id!), eq(nodes.siteId, siteId)),
    with: { contentType: true },
  }) ?? null;
  if (!node) return Astro.redirect("/admin/content");
  contentType = (node as any).contentType;
}

const site = Astro.locals.site;
const allLocales = (site?.locales as string[] | null) ?? ["es"];
const isTranslatable = contentType?.translatable ?? true;
const availableLocales = isTranslatable ? allLocales : [allLocales[0]];

const canEdit = await checkPermission(db, userId, siteId, contentType?.id ?? "", "edit");
const canPublish = await checkPermission(db, userId, siteId, contentType?.id ?? "", "publish");
const canDelete = await checkPermission(db, userId, siteId, contentType?.id ?? "", "delete");

let translations: { id: string; locale: string; title: string; path: string }[] = [];
if (!isNew && node?.translationGroupId) {
  const siblings = await db.query.nodes.findMany({
    where: and(
      eq(nodes.translationGroupId, node.translationGroupId),
      isNotNull(nodes.locale)
    ),
  });
  translations = siblings
    .filter((s) => s.id !== node!.id)
    .map((s) => ({ id: s.id, locale: s.locale, title: s.title, path: s.path }));
}

const pageTitle = isNew
  ? `Nuevo ${contentType?.label}`
  : `Editar: ${node?.title}`;
---

<AdminLayout title={pageTitle}>
  <div class="mb-4">
    <a href="/admin/content" class="btn btn-ghost btn-sm">
      ← Volver a contenido
    </a>
  </div>

  {!isNew && node && (
    <div class="flex gap-2 mb-6">
      <span class={`badge ${node.status === "published" ? "badge-success" : node.status === "scheduled" ? "badge-warning" : "badge-ghost"}`}>
        {node.status}
      </span>
      <span class="text-sm text-base-content/50 font-mono">{node.path}</span>
      {node.status === "published" && (
        <a href={node.path} target="_blank" class="btn btn-xs btn-outline ml-2">
          Ver en sitio ↗
        </a>
      )}
    </div>
  )}

  {!canEdit && !isNew && (
    <div class="alert alert-warning mb-4">
      <span>Solo lectura — no tienes permiso para editar este tipo de contenido.</span>
    </div>
  )}

  {/*
    client:only, not client:load.

    NodeForm has two template roots — the form and the media picker modal — and its fields go
    through FieldRenderer, which loads the repeater, relation and sections editors with
    defineAsyncComponent to break an import cycle. On the server those async components render
    nothing; on the client they resolve. The node counts differ, hydration mis-anchors, and Vue
    re-renders everything after the sections field as *new* nodes — so «Traducciones», «SEO» and
    «Guardar cambios» appeared twice, the second copy outside the form's own container.

    Skipping SSR for this island removes the mismatch entirely. Same fix the node tree already
    needed, for the same reason.
  */}
  {/*
    A skeleton while the island loads.

    `client:only` renders nothing on the server, so without this the editor is a blank area for
    as long as the bundle takes. Hidden by CSS the moment the island has any child, which needs
    no script and cannot get out of sync with hydration.
  */}
  <div class="editor-skeleton flex flex-col gap-4" aria-hidden="true">
    <div class="h-4 w-20 rounded bg-base-300/60"></div>
    <div class="h-10 w-full max-w-3xl rounded-lg bg-base-300/40"></div>
    <div class="h-4 w-16 rounded bg-base-300/60"></div>
    <div class="h-10 w-full max-w-3xl rounded-lg bg-base-300/40"></div>
    <div class="h-28 w-full max-w-3xl rounded-lg bg-base-300/40"></div>
  </div>

  <NodeForm
    client:only="vue"
    nodeId={isNew ? undefined : id}
    contentTypeId={contentType?.id ?? ""}
    fieldSchema={contentType?.fieldSchema ?? []}
    availableLocales={availableLocales}
    translations={translations}
    canEdit={isNew ? true : canEdit}
    canPublish={canPublish}
    canDelete={canDelete}
    initialData={node ? {
      title: node.title,
      slug: node.slug,
      locale: node.locale,
      translationGroupId: node.translationGroupId ?? undefined,
      fields: (node.fields as Record<string, unknown>) ?? {},
      seo: (node.seo as Record<string, unknown>) ?? {},
      status: node.status,
    } : undefined}
  />
</AdminLayout>
