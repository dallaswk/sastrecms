---
import AdminLayout from "@layouts/AdminLayout.astro";
import NodeTree from "@components/admin/NodeTree.vue";
import type { TreeNode } from "@components/admin/nodeTreeContext";
import { eq, and } from "drizzle-orm";
import { nodes, contentTypes, userRoles } from "@db/schema";
import { checkPermission } from "@lib/permissions";
export const prerender = false;

const db = Astro.locals.db;
const siteId = Astro.locals.siteId;
const userId = Astro.locals.user!.id;

const allNodes = await db.query.nodes.findMany({
  where: eq(nodes.siteId, siteId),
  orderBy: (n, { asc }) => [asc(n.position), asc(n.path)],
  with: { contentType: true },
});

const allContentTypes = await db.query.contentTypes.findMany({
  where: eq(contentTypes.siteId, siteId),
});


const assignment = await db.query.userRoles.findFirst({
  where: and(eq(userRoles.userId, userId), eq(userRoles.siteId, siteId)),
  with: { role: true },
});
const isAdmin = assignment?.role.key === "admin";

const canCreatePerType: Record<string, boolean> = {};
const editableTypeIds: string[] = [];
const deletableTypeIds: string[] = [];
const viewableTypeIds = new Set<string>();
for (const ct of allContentTypes) {
  canCreatePerType[ct.id] = await checkPermission(db, userId, siteId, ct.id, "create");
  if (await checkPermission(db, userId, siteId, ct.id, "view")) viewableTypeIds.add(ct.id);
  if (await checkPermission(db, userId, siteId, ct.id, "edit")) editableTypeIds.push(ct.id);
  if (await checkPermission(db, userId, siteId, ct.id, "delete")) deletableTypeIds.push(ct.id);
}

/*
 * A node whose type the user cannot view is dropped, but its children are kept and
 * lifted to where it stood. Hiding a whole branch because of its parent would make
 * content the user *can* view unreachable, and reordering it impossible.
 */
const visibleNodes = allNodes.filter((n) => viewableTypeIds.has(n.contentTypeId));
const visibleIds = new Set(visibleNodes.map((n) => n.id));
const byId = new Map(allNodes.map((n) => [n.id, n]));

function nearestVisibleParent(parentId: string | null): string | null {
  let current = parentId;
  while (current && !visibleIds.has(current)) {
    current = byId.get(current)?.parentId ?? null;
  }
  return current;
}

type RawNode = typeof allNodes[number] & { contentType: typeof allContentTypes[number] | null };

function buildTree(flat: RawNode[], parentId: string | null = null): TreeNode[] {
  return flat
    .filter((n) => nearestVisibleParent(n.parentId ?? null) === parentId)
    .map((n) => ({
      id: n.id,
      title: n.title,
      slug: n.slug,
      path: n.path,
      status: n.status,
      locale: n.locale,
      position: n.position,
      parentId: n.parentId ?? null,
      contentTypeId: n.contentTypeId,
      contentType: n.contentType
        ? { key: n.contentType.key, label: n.contentType.label, icon: n.contentType.icon ?? undefined }
        : undefined,
      children: buildTree(flat, n.id),
    }));
}

const treeData = buildTree(visibleNodes as RawNode[]);
const creatableTypes = allContentTypes.filter((ct) => canCreatePerType[ct.id]);
---

<AdminLayout
  title="Contenido"
  description="El árbol de páginas del sitio. Arrastra para reordenar o anidar."
>
  <div class="flex justify-between items-center mb-6 gap-4 flex-wrap">
    <div class="flex items-center gap-2">
      <h1 class="font-semibold text-lg">Árbol de contenido</h1>
      <span class="badge badge-ghost badge-sm">{visibleNodes.length} nodos</span>
    </div>
    {creatableTypes.length > 0 && (
      <div class="dropdown dropdown-end">
        <label tabindex="0" class="btn btn-primary btn-sm">+ Nuevo</label>
        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box w-52 shadow z-50 mt-1">
          {creatableTypes.map((ct) => (
            <li><a href={`/admin/content/new?type=${ct.id}`}>{ct.icon ?? ""} {ct.label}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>

  {visibleNodes.length === 0 ? (
    <div class="text-center py-20 text-base-content/40">
      <p class="text-lg">No hay contenido todavía.</p>
      {creatableTypes.length > 0 && (
        <p class="text-sm mt-1">Crea tu primer nodo usando el botón "+ Nuevo".</p>
      )}
    </div>
  ) : (
    <div class="panel">
      <div class="card-body p-3">
        <NodeTree
          client:only="vue"
          nodes={JSON.stringify(treeData)}
          editableTypes={isAdmin ? null : JSON.stringify(editableTypeIds)}
          deletableTypes={isAdmin ? null : JSON.stringify(deletableTypeIds)}
          defaultLocale={Astro.locals.site?.defaultLocale ?? "es"}
        />
      </div>
    </div>
  )}

</AdminLayout>
