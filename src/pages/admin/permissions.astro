---
import AdminLayout from "@layouts/AdminLayout.astro";
import PermissionsMatrix from "@components/admin/PermissionsMatrix.vue";
import { eq } from "drizzle-orm";
import { roles, contentTypes } from "@db/schema";
export const prerender = false;

const siteId = Astro.locals.siteId;

// Admin-only: this page reads the permission matrix / user roles / the Resend key.
if (!Astro.locals.isAdmin) return Astro.redirect("/admin");

const db = Astro.locals.db;
const allRoles = await db.query.roles.findMany({
  where: eq(roles.siteId, siteId),
  with: { permissions: { with: { contentType: true } } },
});

const allContentTypes = await db.query.contentTypes.findMany({
  where: eq(contentTypes.siteId, siteId),
});
---

<AdminLayout
  title="Permisos"
  description="Qué puede hacer cada rol con cada tipo de contenido."
>
  <p class="admin-hint mb-5">
    Los cambios se guardan automáticamente al marcar o desmarcar.
  </p>

  {allRoles.length === 0 ? (
    <div class="alert alert-warning">
      <span>No hay roles creados todavía. Los roles se crean automáticamente al ejecutar el seed inicial.</span>
    </div>
  ) : (
    <PermissionsMatrix
      client:load
      roles={allRoles}
      contentTypes={allContentTypes}
    />
  )}
</AdminLayout>
