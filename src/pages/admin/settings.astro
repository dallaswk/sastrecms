---
import AdminLayout from "@layouts/AdminLayout.astro";
import MediaField from "@components/admin/MediaField.vue";
// The same list Tailwind compiles from, so the selector cannot offer a theme that does not
// exist. It used to list all 32 while the config generated 2.
import {
  SITE_THEMES,
  THEME_LABELS,
  FONTS,
  CONTAINER_WIDTHS,
  TYPE_SCALES,
  DEFAULT_THEME,
  DEFAULT_CONTAINER,
  DEFAULT_TYPE_SCALE,
  DEFAULT_FONT,
} from "@lib/theme";
import { eq } from "drizzle-orm";
import { settings } from "@db/schema";
export const prerender = false;

// Admin-only: this page reads the permission matrix / user roles / the Resend key.
if (!Astro.locals.isAdmin) return Astro.redirect("/admin");

const db = Astro.locals.db;
const siteSettings = await db.query.settings.findFirst({
  where: eq(settings.siteId, Astro.locals.siteId),
});

const theme = (siteSettings?.theme as Record<string, string>) ?? {};
const socialLinks = (siteSettings?.socialLinks as Record<string, string>) ?? {};
const redirects = (siteSettings?.redirects as { from: string; to: string; permanent: boolean }[]) ?? [];
const analyticsIds = (siteSettings?.analyticsIds as Record<string, string>) ?? {};
const integrations = (siteSettings?.integrations as Record<string, string>) ?? {};


---

<AdminLayout title="Ajustes">
  <form id="settings-form" class="flex flex-col gap-8 max-w-2xl">

    <!-- General -->
    <section class="card bg-base-100 border border-base-300">
      <div class="card-body gap-4">
        <h2 class="card-title text-base">General</h2>
        <div class="form-control">
          <label class="label"><span class="label-text">Nombre del sitio</span></label>
          <input name="siteName" type="text" class="input input-bordered" value={siteSettings?.siteName ?? ""} />
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Tagline</span></label>
          <input name="tagline" type="text" class="input input-bordered" value={siteSettings?.tagline ?? ""} />
        </div>
        <div class="form-control">
          <label class="label">
            <span class="label-text">Correo de contacto</span>
            <span class="label-text-alt text-base-content/40">Avisos de los formularios</span>
          </label>
          <input name="contactEmail" type="email" class="input input-bordered" value={siteSettings?.contactEmail ?? ""} placeholder="hola@tudominio.com" />
          <label class="label">
            <span class="label-text-alt text-base-content/40">
              Adónde llegan los mensajes del formulario de contacto, salvo que una sección
              indique otro. Los mensajes se guardan en <a href="/admin/forms" class="link">Mensajes</a> aunque el correo falle.
            </span>
          </label>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Logo</span></label>
          <MediaField
            client:load
            name="logoUrl"
            initial={siteSettings?.logoUrl ?? ""}
            hint="Se muestra en la cabecera. Un PNG o SVG con fondo transparente."
          />
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Favicon</span></label>
          <MediaField
            client:load
            name="faviconUrl"
            initial={siteSettings?.faviconUrl ?? ""}
            square
            hint="Cuadrado y pequeño: 32×32 o un SVG. Se ve en la pestaña del navegador."
          />
        </div>
      </div>
    </section>

    <!-- Theme -->
    <section class="card bg-base-100 border border-base-300">
      <div class="card-body gap-4">
        <h2 class="card-title text-base">Tema</h2>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Tema base</span>
            <span class="label-text-alt text-base-content/40">Los colores de abajo lo sobreescriben</span>
          </label>
          <select name="daisyuiTheme" class="select select-bordered">
            {SITE_THEMES.map((t) => (
              <option value={t} selected={(theme.daisyuiTheme ?? DEFAULT_THEME) === t}>
                {THEME_LABELS[t]}
              </option>
            ))}
          </select>
          <label class="label">
            <span class="label-text-alt text-base-content/40">
              Ocho temas, no los treinta y dos de daisyUI: cada uno añade su paleta completa
              a la hoja de estilos de todas las páginas, así que generarlos todos le cobra a
              cada visitante una decisión que se toma una vez.
            </span>
          </label>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="form-control">
            <label class="label"><span class="label-text">Color primario</span></label>
            <div class="flex gap-2 items-center">
              <input type="color" name="primaryColor" class="w-10 h-10 rounded cursor-pointer border border-base-300" value={theme.primaryColor ?? "#570df8"} />
              <input type="text" name="primaryColorText" class="input input-bordered input-sm flex-1 font-mono" value={theme.primaryColor ?? ""} />
            </div>
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text">Color secundario</span></label>
            <div class="flex gap-2 items-center">
              <input type="color" name="secondaryColor" class="w-10 h-10 rounded cursor-pointer border border-base-300" value={theme.secondaryColor ?? "#f000b8"} />
              <input type="text" name="secondaryColorText" class="input input-bordered input-sm flex-1 font-mono" value={theme.secondaryColor ?? ""} />
            </div>
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text">Color acento</span></label>
            <div class="flex gap-2 items-center">
              <input type="color" name="accentColor" class="w-10 h-10 rounded cursor-pointer border border-base-300" value={theme.accentColor ?? "#37cdbe"} />
              <input type="text" name="accentColorText" class="input input-bordered input-sm flex-1 font-mono" value={theme.accentColor ?? ""} />
            </div>
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text">Redondeo de esquinas</span></label>
            <input type="text" name="borderRadius" class="input input-bordered" placeholder="p. ej. 0.5rem" value={theme.borderRadius ?? ""} />
          </div>
        </div>

        <div class="divider my-0"></div>

        <div class="grid grid-cols-2 gap-4">
          <div class="form-control">
            <label class="label"><span class="label-text">Fuente de titulares</span></label>
            <select name="fontHeading" class="select select-bordered">
              {FONTS.map((font) => (
                <option value={font.key} selected={(theme.fontHeading ?? DEFAULT_FONT) === font.key}>
                  {font.label}{font.google ? " · Google" : ""}
                </option>
              ))}
            </select>
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text">Fuente del texto</span></label>
            <select name="fontBody" class="select select-bordered">
              {FONTS.map((font) => (
                <option value={font.key} selected={(theme.fontBody ?? DEFAULT_FONT) === font.key}>
                  {font.label}{font.google ? " · Google" : ""}
                </option>
              ))}
            </select>
          </div>
        </div>
        <p class="text-xs text-base-content/50 -mt-2">
          Las marcadas «Google» se descargan de Google Fonts, lo que envía la IP de cada
          visitante a Google. Las «del sistema» no hacen ninguna petición externa.
        </p>

        <div class="grid grid-cols-2 gap-4">
          <div class="form-control">
            <label class="label"><span class="label-text">Ancho del contenido</span></label>
            <select name="containerWidth" class="select select-bordered">
              {CONTAINER_WIDTHS.map((width) => (
                <option value={width.key} selected={(theme.containerWidth ?? DEFAULT_CONTAINER) === width.key}>
                  {width.label}
                </option>
              ))}
            </select>
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text">Escala tipográfica</span></label>
            <select name="typeScale" class="select select-bordered">
              {TYPE_SCALES.map((scale) => (
                <option value={scale.key} selected={(theme.typeScale ?? DEFAULT_TYPE_SCALE) === scale.key}>
                  {scale.label}
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>
    </section>

    <!-- Social links -->
    <section class="card bg-base-100 border border-base-300">
      <div class="card-body gap-4">
        <h2 class="card-title text-base">Redes sociales</h2>
        {(["twitter","instagram","linkedin","facebook","youtube","github"] as const).map((net) => (
          <div class="form-control">
            <label class="label"><span class="label-text capitalize">{net}</span></label>
            <input name={`social_${net}`} type="url" class="input input-bordered" value={socialLinks[net] ?? ""} placeholder={`https://${net}.com/...`} />
          </div>
        ))}
      </div>
    </section>

    <!-- Analytics -->
    <section class="card bg-base-100 border border-base-300">
      <div class="card-body gap-4">
        <h2 class="card-title text-base">Analytics y seguimiento</h2>
        <p class="text-sm text-base-content/50">Deja en blanco los que no uses. Los scripts se inyectan automáticamente en todas las páginas públicas.</p>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Google Analytics 4</span>
            <span class="label-text-alt text-base-content/40">Measurement ID (G-XXXXXXXXXX)</span>
          </label>
          <input name="analytics_ga4" type="text" class="input input-bordered font-mono" value={analyticsIds.ga4 ?? ""} placeholder="G-XXXXXXXXXX" />
          <label class="label py-0"><span class="label-text-alt text-base-content/40">Empieza por G- (ej. G-ABC1234)</span></label>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Google Tag Manager</span>
            <span class="label-text-alt text-base-content/40">Container ID (GTM-XXXXXXX)</span>
          </label>
          <input name="analytics_gtm" type="text" class="input input-bordered font-mono" value={analyticsIds.gtm ?? ""} placeholder="GTM-XXXXXXX" />
          <label class="label py-0"><span class="label-text-alt text-base-content/40">Empieza por GTM- (ej. GTM-ABC123)</span></label>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Meta Pixel (Facebook)</span>
            <span class="label-text-alt text-base-content/40">Pixel ID</span>
          </label>
          <input name="analytics_metaPixel" type="text" class="input input-bordered font-mono" value={analyticsIds.metaPixel ?? ""} placeholder="123456789012345" />
          <label class="label py-0"><span class="label-text-alt text-base-content/40">Sólo dígitos (ej. 1234567890123)</span></label>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">TikTok Pixel</span>
            <span class="label-text-alt text-base-content/40">Pixel ID</span>
          </label>
          <input name="analytics_tiktokPixel" type="text" class="input input-bordered font-mono" value={analyticsIds.tiktokPixel ?? ""} placeholder="CXXXXXXXXXXXXXXXXX" />
          <label class="label py-0"><span class="label-text-alt text-base-content/40">Letras y dígitos (ej. C4A1B2C3D4E5)</span></label>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Hotjar</span>
            <span class="label-text-alt text-base-content/40">Site ID</span>
          </label>
          <input name="analytics_hotjar" type="text" class="input input-bordered font-mono" value={analyticsIds.hotjar ?? ""} placeholder="1234567" />
          <label class="label py-0"><span class="label-text-alt text-base-content/40">Sólo el Site ID numérico (ej. 1234567), no el script entero</span></label>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Google Search Console</span>
            <span class="label-text-alt text-base-content/40">Meta tag verification content</span>
          </label>
          <input name="analytics_gscVerification" type="text" class="input input-bordered font-mono" value={analyticsIds.gscVerification ?? ""} placeholder="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
          <label class="label py-0"><span class="label-text-alt text-base-content/40">El token de la meta, no la etiqueta completa</span></label>
        </div>
      </div>
    </section>

    <!-- Integraciones -->
    <section class="card bg-base-100 border border-base-300">
      <div class="card-body gap-4">
        <h2 class="card-title text-base">Integraciones</h2>
        <p class="text-sm text-base-content/50">Credenciales de servicios externos. Se almacenan en la base de datos del sitio.</p>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Resend API Key</span>
            <span class="label-text-alt text-base-content/40">Para magic link e emails transaccionales</span>
          </label>
          <input
            name="resendApiKey"
            type="password"
            class="input input-bordered font-mono"
            value={integrations.resendApiKey ?? ""}
            placeholder="re_xxxxxxxxxxxxxxxxxxxxxxxx"
            autocomplete="off"
          />
          <label class="label">
            <span class="label-text-alt text-base-content/40">
              Obtén tu key en <a href="https://resend.com/api-keys" target="_blank" class="link">resend.com/api-keys</a>.
              Necesaria para que el magic link funcione.
            </span>
          </label>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Dirección de envío (from)</span>
            <span class="label-text-alt text-base-content/40">Debe estar verificada en Resend</span>
          </label>
          <input
            name="resendFrom"
            type="text"
            class="input input-bordered font-mono"
            value={integrations.resendFrom ?? ""}
            placeholder="sASTRe <noreply@tudominio.com>"
            autocomplete="off"
          />
          <label class="label">
            <span class="label-text-alt text-base-content/40">
              Formato: <code>Nombre &lt;correo@dominio.com&gt;</code> · Verifica el dominio en
              <a href="https://resend.com/domains" target="_blank" class="link">resend.com/domains</a>
            </span>
          </label>
        </div>

        <div class="divider my-0"></div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Turnstile · clave del sitio</span>
            <span class="label-text-alt text-base-content/40">Anti-spam de los formularios</span>
          </label>
          <input
            name="turnstileSiteKey"
            type="text"
            class="input input-bordered font-mono"
            value={integrations.turnstileSiteKey ?? ""}
            placeholder="0x4AAAAAAA…"
            autocomplete="off"
          />
          <label class="label">
            <span class="label-text-alt text-base-content/40">
              Pública: se imprime en el HTML del formulario. Créala en
              <a href="https://dash.cloudflare.com/?to=/:account/turnstile" target="_blank" class="link">Cloudflare Turnstile</a>.
            </span>
          </label>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Turnstile · clave secreta</span>
          </label>
          <input
            name="turnstileSecretKey"
            type="password"
            class="input input-bordered font-mono"
            value={integrations.turnstileSecretKey ?? ""}
            placeholder="0x4AAAAAAA…"
            autocomplete="off"
          />
          <label class="label">
            <span class="label-text-alt text-base-content/40">
              Sin ella los formularios siguen funcionando con el honeypot y el límite de
              envíos, pero sin verificación de Cloudflare.
            </span>
          </label>
        </div>
      </div>
    </section>

    <!-- Navigation moved out: it is edited by anyone with a role on the site, and this
         page is admin-only. Left as a pointer because that is where it used to live. -->
    <p class="text-sm text-base-content/60">
      Los menús de la cabecera y el pie se editan en <a href="/admin/menus" class="link">Menús</a>.
    </p>

    <!-- Redirects -->
    <section class="card bg-base-100 border border-base-300">
      <div class="card-body gap-4">
        <h2 class="card-title text-base">Redirecciones</h2>
        <div id="redirects-list" class="flex flex-col gap-2">
          {redirects.map((r, i) => (
            <div class="flex gap-2 items-center redirect-row">
              <input type="text" name={`redirect_from_${i}`} class="input input-bordered input-sm flex-1" value={r.from} placeholder="/antigua-ruta" />
              <span class="text-base-content/50">→</span>
              <input type="text" name={`redirect_to_${i}`} class="input input-bordered input-sm flex-1" value={r.to} placeholder="/nueva-ruta" />
              <label class="flex gap-1 items-center text-sm">
                <input type="checkbox" name={`redirect_permanent_${i}`} class="checkbox checkbox-sm" checked={r.permanent} />
                301
              </label>
              <button type="button" class="btn btn-xs btn-ghost text-error remove-redirect">✕</button>
            </div>
          ))}
        </div>
        <button type="button" id="add-redirect" class="btn btn-sm btn-ghost self-start">+ Añadir redirección</button>
      </div>
    </section>

    <div class="flex gap-3 items-center">
      <button type="submit" class="btn btn-primary">Guardar ajustes</button>
      <span id="settings-msg" class="text-sm"></span>
    </div>
  </form>
</AdminLayout>

<script>
  import { actions } from "astro:actions";

  let redirectIndex = document.querySelectorAll(".redirect-row").length;

  document.getElementById("add-redirect")?.addEventListener("click", () => {
    const container = document.getElementById("redirects-list")!;
    const row = document.createElement("div");
    row.className = "flex gap-2 items-center redirect-row";
    row.innerHTML = `
      <input type="text" name="redirect_from_${redirectIndex}" class="input input-bordered input-sm flex-1" placeholder="/antigua-ruta" />
      <span class="text-base-content/50">→</span>
      <input type="text" name="redirect_to_${redirectIndex}" class="input input-bordered input-sm flex-1" placeholder="/nueva-ruta" />
      <label class="flex gap-1 items-center text-sm">
        <input type="checkbox" name="redirect_permanent_${redirectIndex}" class="checkbox checkbox-sm" />
        301
      </label>
      <button type="button" class="btn btn-xs btn-ghost text-error remove-redirect">✕</button>
    `;
    container.appendChild(row);
    redirectIndex++;
    attachRemoveListeners();
  });

  function attachRemoveListeners() {
    document.querySelectorAll(".remove-redirect").forEach((btn) => {
      (btn as HTMLElement).onclick = () => {
        (btn as HTMLElement).closest(".redirect-row")?.remove();
      };
    });
  }
  attachRemoveListeners();

  /** Human names for the settings that carry a format rule. */
  const FIELD_LABELS: Record<string, string> = {
    ga4: "Google Analytics 4",
    gtm: "Google Tag Manager",
    metaPixel: "Meta Pixel",
    tiktokPixel: "TikTok Pixel",
    hotjar: "Hotjar",
    gscVerification: "Search Console",
    twitter: "Twitter", instagram: "Instagram", linkedin: "LinkedIn",
    facebook: "Facebook", youtube: "YouTube", github: "GitHub",
  };

  type ActionIssue = { path?: (string | number)[]; message?: string };
  type MaybeInputError = { message: string; issues?: ActionIssue[] };

  /**
   * Turns a validation failure into a sentence that names the field.
   *
   * `error.message` on an input error is zod's issue list serialised, so one malformed
   * analytics id used to block the whole form and answer with a JSON dump.
   */
  function describeError(error: MaybeInputError): string {
    const issues = error.issues ?? [];
    if (!issues.length) return error.message;

    const parts = issues.map((issue) => {
      const key = String(issue.path?.[issue.path.length - 1] ?? "");
      const label = FIELD_LABELS[key] ?? key;
      return label ? `${label}: ${issue.message ?? "valor no válido"}` : (issue.message ?? "");
    });
    return `No se ha guardado nada. ${[...new Set(parts)].filter(Boolean).join(" · ")}`;
  }

  /** Marks the inputs that failed, so the message and the form agree. */
  function highlightInvalid(form: HTMLFormElement, error: MaybeInputError) {
    form.querySelectorAll(".input-error").forEach((el) => el.classList.remove("input-error"));
    for (const issue of error.issues ?? []) {
      const key = String(issue.path?.[issue.path.length - 1] ?? "");
      const input =
        form.querySelector(`[name="analytics_${key}"]`) ?? form.querySelector(`[name="${key}"]`);
      input?.classList.add("input-error");
    }
  }

  document.getElementById("settings-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const msg = document.getElementById("settings-msg")!;

    const redirectRows = document.querySelectorAll(".redirect-row");
    const redirects: { from: string; to: string; permanent: boolean }[] = [];
    redirectRows.forEach((_row, i) => {
      const from = (data.get(`redirect_from_${i}`) as string)?.trim();
      const to = (data.get(`redirect_to_${i}`) as string)?.trim();
      const permanent = data.get(`redirect_permanent_${i}`) === "on";
      if (from && to) redirects.push({ from, to, permanent });
    });

    const { error } = await actions.settings.update({
      siteName: data.get("siteName") as string,
      tagline: data.get("tagline") as string,
      contactEmail: data.get("contactEmail") as string,
      logoUrl: data.get("logoUrl") as string,
      faviconUrl: data.get("faviconUrl") as string,
      theme: {
        daisyuiTheme: data.get("daisyuiTheme") as string,
        primaryColor: data.get("primaryColor") as string,
        secondaryColor: data.get("secondaryColor") as string,
        accentColor: data.get("accentColor") as string,
        borderRadius: data.get("borderRadius") as string,
        fontHeading: data.get("fontHeading") as string,
        fontBody: data.get("fontBody") as string,
        containerWidth: data.get("containerWidth") as string,
        typeScale: data.get("typeScale") as string,
      },
      socialLinks: {
        twitter: data.get("social_twitter") as string,
        instagram: data.get("social_instagram") as string,
        linkedin: data.get("social_linkedin") as string,
        facebook: data.get("social_facebook") as string,
        youtube: data.get("social_youtube") as string,
        github: data.get("social_github") as string,
      },
      redirects,
      analyticsIds: {
        ga4: (data.get("analytics_ga4") as string)?.trim() || undefined,
        gtm: (data.get("analytics_gtm") as string)?.trim() || undefined,
        metaPixel: (data.get("analytics_metaPixel") as string)?.trim() || undefined,
        tiktokPixel: (data.get("analytics_tiktokPixel") as string)?.trim() || undefined,
        hotjar: (data.get("analytics_hotjar") as string)?.trim() || undefined,
        gscVerification: (data.get("analytics_gscVerification") as string)?.trim() || undefined,
      },
      integrations: {
        resendApiKey: (data.get("resendApiKey") as string)?.trim() || undefined,
        resendFrom: (data.get("resendFrom") as string)?.trim() || undefined,
      },
    });

    if (error) {
      msg.className = "text-sm text-error";
      msg.textContent = describeError(error);
      // Point at the offending input instead of making them decode a path.
      highlightInvalid(form, error);
    } else {
      msg.className = "text-sm text-success";
      msg.textContent = "Guardado correctamente";
      setTimeout(() => window.location.reload(), 800);
    }
  });
</script>
