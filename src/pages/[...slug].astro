---
import { eq, and, isNotNull } from "drizzle-orm";
import { nodes, contentTypes } from "@db/schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildWebPageSchema, buildArticleSchema, buildBreadcrumbSchema, buildOrganizationSchema } from "@lib/jsonld";
import { resolveRenderer, sectionsFieldOf } from "@lib/renderers";
import { parseSections } from "@lib/sections/validate";
import GenericRenderer from "@components/renderers/GenericRenderer.astro";
import SectionList from "@components/sections/SectionList.astro";
import PostRenderer from "@components/renderers/PostRenderer.astro";
import PortfolioItemRenderer from "@components/renderers/PortfolioItemRenderer.astro";
import ArchiveRenderer from "@components/renderers/ArchiveRenderer.astro";
export const prerender = false;

const db = Astro.locals.db;
const siteId = Astro.locals.siteId;

const slugParam = Astro.params.slug ?? "";
const path = slugParam ? `/${slugParam}` : "/";

const node = await db.query.nodes.findFirst({
  where: and(
    eq(nodes.siteId, siteId),
    eq(nodes.path, path),
    eq(nodes.status, "published")
  ),
  with: { contentType: true },
});

if (!node) return new Response(null, { status: 404 });

const ct = (node as typeof node & { contentType: typeof contentTypes.$inferSelect }).contentType;

const seo = (node.seo as Record<string, unknown>) ?? {};
const fields = (node.fields as Record<string, unknown>) ?? {};
const nodeUrl = new URL(node.path, Astro.url.origin).toString();

const jsonLd = ct?.key === "post"
  ? buildArticleSchema({
      url: nodeUrl,
      title: node.title,
      description: seo.metaDescription as string | undefined,
      image: (fields.cover_image ?? seo.ogImage) as string | undefined,
      datePublished: node.publishedAt as Date | null,
      dateModified: node.updatedAt as Date | null,
    })
  : buildWebPageSchema({
      url: nodeUrl,
      title: (seo.metaTitle as string) || node.title,
      description: seo.metaDescription as string | undefined,
      image: seo.ogImage as string | undefined,
      datePublished: node.publishedAt as Date | null,
      dateModified: node.updatedAt as Date | null,
    });

let children: typeof nodes.$inferSelect[] = [];
if (ct?.hasArchive) {
  children = await db.query.nodes.findMany({
    where: and(
      eq(nodes.parentId, node.id),
      eq(nodes.status, "published")
    ),
    orderBy: (n, { desc }) => [desc(n.publishedAt)],
  });
}

let hreflangLinks: { locale: string; path: string }[] = [];
if (node.translationGroupId) {
  const translations = await db.query.nodes.findMany({
    where: and(
      eq(nodes.translationGroupId, node.translationGroupId),
      eq(nodes.status, "published"),
      isNotNull(nodes.locale)
    ),
  });
  hreflangLinks = translations.map((t) => ({ locale: t.locale, path: t.path }));
}

const siteSettings = Astro.locals.settings;

const orgSchema = buildOrganizationSchema({
  name: siteSettings?.siteName ?? "sASTRe",
  url: Astro.url.origin,
  logo: siteSettings?.logoUrl ?? undefined,
  sameAs: Object.values(
    (siteSettings?.socialLinks as Record<string, string> | null) ?? {}
  ).filter(Boolean),
});

const breadcrumbParts = node.path.split("/").filter(Boolean);
const breadcrumbItems = [
  { name: siteSettings?.siteName ?? "Inicio", url: Astro.url.origin + "/" },
  ...breadcrumbParts.map((_, i) => {
    const partPath = "/" + breadcrumbParts.slice(0, i + 1).join("/");
    return { name: breadcrumbParts[i], url: Astro.url.origin + partPath };
  }),
];
breadcrumbItems[breadcrumbItems.length - 1].name = node.title;
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);

const allJsonLd = [jsonLd, orgSchema, breadcrumbSchema];

const renderer = resolveRenderer(ct, fields);
// Parsed on the read path and never written back: rendering stays a read. Errors are
// swallowed here on purpose — a block the editor saved before a schema change should
// degrade to "not shown", not to a broken page.
const sectionsField = sectionsFieldOf(ct);
const parsed =
  renderer === "sections" && sectionsField
    ? parseSections(fields[sectionsField.key])
    : { sections: [], errors: [] };
const sections = parsed.sections;
// Surfaced in dev only: in production a block that no longer validates just does not
// render, but while building a site silently losing one is worse than an ugly banner.
const sectionErrors = parsed.errors;
---

<BaseLayout
  title={(seo.metaTitle as string) || node.title}
  description={seo.metaDescription as string}
  ogImage={seo.ogImage as string}
  noindex={seo.noindex as boolean}
  jsonLdList={allJsonLd}
  hreflangLinks={hreflangLinks}
  lang={node.locale}
>
  {renderer === "sections" ? (
    <SectionList sections={sections} errors={sectionErrors} />
  ) : renderer === "archive" ? (
    <ArchiveRenderer node={node} contentType={ct} children={children} fields={fields} />
  ) : renderer === "post" ? (
    <PostRenderer node={node} contentType={ct} fields={fields} />
  ) : renderer === "portfolio_item" ? (
    <PortfolioItemRenderer node={node} contentType={ct} fields={fields} />
  ) : (
    <GenericRenderer node={node} contentType={ct} fields={fields} />
  )}
</BaseLayout>
