---
import { eq, and, isNotNull } from "drizzle-orm";
import { nodes, contentTypes } from "@db/schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildWebPageSchema, buildArticleSchema, buildBreadcrumbSchema, buildOrganizationSchema } from "@lib/jsonld";
import { resolveRenderer, sectionsFieldOf } from "@lib/renderers";
import { lookupMedia } from "@lib/media-lookup";
import { tagsForNode, PUBLIC_CACHE } from "@lib/cache-tags";
import { visibleNodes, previewableNodes } from "@lib/node-queries";
import { verifyPreviewToken, PREVIEW_PARAM } from "@lib/preview";
import { nextScheduledAt, cacheTtlFor } from "@lib/publishing";
import { collectMediaUrls } from "@lib/media-url";
import { parseSections } from "@lib/sections/validate";
import GenericRenderer from "@components/renderers/GenericRenderer.astro";
import SectionList from "@components/sections/SectionList.astro";
import PostRenderer from "@components/renderers/PostRenderer.astro";
import PortfolioItemRenderer from "@components/renderers/PortfolioItemRenderer.astro";
import ArchiveRenderer from "@components/renderers/ArchiveRenderer.astro";
export const prerender = false;

const db = Astro.locals.db;
const siteId = Astro.locals.siteId;

const slugParam = Astro.params.slug ?? "";
const path = slugParam ? `/${slugParam}` : "/";

/*
 * One `now` for the whole render.
 *
 * Two queries comparing against two different instants could include a node in a listing and
 * then 404 on its own page — a race that would only show up at the moment something goes live.
 */
const now = new Date();

/*
 * A preview link lets a draft through, for this one page only.
 *
 * The node id is inside the signature, so a token cannot be moved to another page, and the
 * response is never cached or indexed — a preview that got cached would serve the draft to
 * everybody who asked for the real URL afterwards.
 */
const previewToken = Astro.url.searchParams.get(PREVIEW_PARAM);
const preview = previewToken
  ? await verifyPreviewToken(previewToken, Astro.locals.env?.BETTER_AUTH_SECRET ?? "", now)
  : null;

const node = await db.query.nodes.findFirst({
  where: and(
    preview?.valid ? previewableNodes(siteId) : visibleNodes(siteId, now),
    eq(nodes.path, path)
  ),
  with: { contentType: true },
});

// Rewritten rather than answered empty: the visitor gets the site's own 404 page, with its
// header and a way back, and the status stays 404 for a crawler.
if (!node) return Astro.rewrite("/404");

const ct = (node as typeof node & { contentType: typeof contentTypes.$inferSelect }).contentType;

const seo = (node.seo as Record<string, unknown>) ?? {};
const fields = (node.fields as Record<string, unknown>) ?? {};
const nodeUrl = new URL(node.path, Astro.url.origin).toString();

const jsonLd = ct?.key === "post"
  ? buildArticleSchema({
      url: nodeUrl,
      title: node.title,
      description: seo.metaDescription as string | undefined,
      image: (fields.cover_image ?? seo.ogImage) as string | undefined,
      datePublished: node.publishedAt as Date | null,
      dateModified: node.updatedAt as Date | null,
    })
  : buildWebPageSchema({
      url: nodeUrl,
      title: (seo.metaTitle as string) || node.title,
      description: seo.metaDescription as string | undefined,
      image: seo.ogImage as string | undefined,
      datePublished: node.publishedAt as Date | null,
      dateModified: node.updatedAt as Date | null,
    });

let children: typeof nodes.$inferSelect[] = [];
if (ct?.hasArchive) {
  children = await db.query.nodes.findMany({
    where: and(visibleNodes(siteId, now), eq(nodes.parentId, node.id)),
    orderBy: (n, { desc }) => [desc(n.publishedAt)],
  });
}

let hreflangLinks: { locale: string; path: string }[] = [];
if (node.translationGroupId) {
  const translations = await db.query.nodes.findMany({
    where: and(
      eq(nodes.translationGroupId, node.translationGroupId),
      eq(nodes.siteId, siteId),
      eq(nodes.status, "published"),
      isNotNull(nodes.locale)
    ),
  });
  hreflangLinks = translations.map((t) => ({ locale: t.locale, path: t.path }));
}

const siteSettings = Astro.locals.settings;

const orgSchema = buildOrganizationSchema({
  name: siteSettings?.siteName ?? "sASTRe",
  url: Astro.url.origin,
  logo: siteSettings?.logoUrl ?? undefined,
  sameAs: Object.values(
    (siteSettings?.socialLinks as Record<string, string> | null) ?? {}
  ).filter(Boolean),
});

const breadcrumbParts = node.path.split("/").filter(Boolean);
const breadcrumbItems = [
  { name: siteSettings?.siteName ?? "Inicio", url: Astro.url.origin + "/" },
  ...breadcrumbParts.map((_, i) => {
    const partPath = "/" + breadcrumbParts.slice(0, i + 1).join("/");
    return { name: breadcrumbParts[i], url: Astro.url.origin + partPath };
  }),
];
breadcrumbItems[breadcrumbItems.length - 1].name = node.title;
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbItems);

const allJsonLd = [jsonLd, orgSchema, breadcrumbSchema];

/*
 * Every image the page is about to render, looked up in one query.
 *
 * Content fields store the URL, not the media id, so the alt text and the dimensions have to
 * be recovered from the URL. Doing it here rather than in each component is the difference
 * between one round trip to Turso and one per image.
 */
const mediaMap = await lookupMedia(db, collectMediaUrls(fields));

/*
 * Cache tags for this page.
 *
 * Emitted through the same functions the actions purge with, so the two cannot drift — a
 * stale page looks exactly like a working one, which makes this the one place where a naming
 * mistake is invisible until a client notices their update never appeared.
 */
/*
 * Scheduled publishing has no write at the moment of publication, so nothing purges. A page
 * cached for an hour would keep showing yesterday's listing for up to an hour after a post went
 * live, so the lifetime is capped at the time left until the next scheduled child.
 */
const upcoming = nextScheduledAt(children, now);

/*
 * A valid token for a *different* page does not open this one.
 *
 * Checked after the lookup because the path is what identifies the page; without this, one
 * token would unlock every draft on the site.
 */
const isPreviewing = !!preview?.valid && preview.nodeId === node.id;

if (previewToken && !isPreviewing) {
  return Astro.rewrite("/404");
}

if (isPreviewing) {
  Astro.response.headers.set("Cache-Control", "private, no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  Astro.cache.set({ maxAge: 0, swr: 0 });
}

if (!isPreviewing) {
  Astro.cache.set({
    ...PUBLIC_CACHE,
    maxAge: cacheTtlFor(PUBLIC_CACHE.maxAge, now, upcoming),
    tags: tagsForNode({
      siteId: Astro.locals.siteId,
      nodeId: node.id,
      contentTypeId: node.contentTypeId,
      referencedNodeIds: children.map((child) => child.id),
      ...(ct?.id ? { referencedTypeIds: [ct.id] } : {}),
    }),
    ...(node.updatedAt ? { lastModified: node.updatedAt } : {}),
  });
}

const renderer = resolveRenderer(ct, fields, {
  hasChildren: children.length > 0,
  isRoot: !node.parentId,
});

// `article` for anything dated, so a crawler reads published/modified instead of guessing.
// A page built out of sections is a landing, not an article.
// From the type, not the renderer: a post is an article however it is laid out.
const ogType = ct?.key === "post" || ct?.key === "portfolio_item" ? "article" : "website";
// Parsed on the read path and never written back: rendering stays a read. Errors are
// swallowed here on purpose — a block the editor saved before a schema change should
// degrade to "not shown", not to a broken page.
const sectionsField = sectionsFieldOf(ct);
const parsed =
  renderer === "sections" && sectionsField
    ? parseSections(fields[sectionsField.key])
    : { sections: [], errors: [] };
const sections = parsed.sections;
// Surfaced in dev only: in production a block that no longer validates just does not
// render, but while building a site silently losing one is worse than an ugly banner.
const sectionErrors = parsed.errors;
---

<BaseLayout
  title={(seo.metaTitle as string) || node.title}
  description={seo.metaDescription as string}
  ogImage={(seo.ogImage as string) || (fields.cover_image as string)}
  ogImageAlt={node.title}
  canonical={seo.canonical as string}
  noindex={seo.noindex as boolean}
  ogType={ogType}
  publishedAt={node.publishedAt?.toISOString()}
  updatedAt={node.updatedAt?.toISOString()}
  jsonLdList={allJsonLd}
  hreflangLinks={hreflangLinks}
  lang={node.locale}
>
  {renderer === "sections" ? (
    <SectionList sections={sections} errors={sectionErrors} nodeId={node.id} media={mediaMap} />
  ) : renderer === "archive" ? (
    <ArchiveRenderer node={node} contentType={ct} children={children} fields={fields} />
  ) : renderer === "post" ? (
    <PostRenderer node={node} contentType={ct} fields={fields} />
  ) : renderer === "portfolio_item" ? (
    <PortfolioItemRenderer node={node} contentType={ct} fields={fields} />
  ) : (
    <GenericRenderer node={node} contentType={ct} fields={fields} />
  )}
</BaseLayout>
